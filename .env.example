# Copy to .env and set your tokens.

# Ask Joule — free models (no credit card)
# This computer: Ollama Qwen 2.5 7B (falls back to DeepSeek R1)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# Remote (and optional local upgrade): Gemini Flash — aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Public URL of the deployed app (used for Google OAuth redirects)
APP_BASE_URL=

# Expert login — required to unlock Sports Scientist / Expert mode
# Required on Railway/Vercel: add as a service Variable
EXPERT_PASSWORD=

# Optional — signs member/expert session tokens (defaults to EXPERT_PASSWORD)
# SESSION_SECRET=

# ── Supabase Postgres (recommended on Railway — JSON data is ephemeral) ─────
# Run database/migrations/001_ayun_schema.sql and 002_app_users.sql in Supabase SQL Editor
# Use the Secret key (Settings → API Keys). Public/publishable is the wrong one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google member sign-in (same third-party login as Garra)
# Create a Web application OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   http://127.0.0.1:5173
#   http://localhost:5173
# Authorized redirect URIs (must match exactly or Google shows redirect_uri_mismatch):
#   http://127.0.0.1:5173/login
#   http://localhost:5173/login
#   https://ayun-full.vercel.app/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Talk with Joule — ElevenLabs voice (free starter credits at https://elevenlabs.io)
# Paste the secret shown once at create time. It starts with sk_
# Do not paste the Key ID from the keys list — that is not the secret.
# Key stays on the server. If empty, Talk falls back to the browser’s robotic voice.
ELEVENLABS_API_KEY=
# Optional. Default eleven_multilingual_v2 is the most natural.
# Faster talk-loop: eleven_flash_v2_5
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional default voice id (Jiaqi if unset)
# ELEVENLABS_VOICE_ID=6q2fEVEF7Uvhqy2k7Ep5
# Other Talk chips: Male coach, Female coach, Helmet (German Cqbq4nsuUe1we6J45miU)

# Comma-separated origins for FastAPI CORS (local React dev)
# On Railway/Vercel with Dockerfile or vercel.json, UI and API share one domain — CORS usually not needed
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional — override JSON data directory (default: backend/data locally, /tmp/ayun-data on Vercel)
# AYUN_DATA_DIR=/tmp/ayun-data
