# Copy to secrets.toml for local dev, or paste into Streamlit Community Cloud "Secrets" field.

GITHUB_TOKEN = "ghp_your_token_here"

APP_BASE_URL = "https://your-app.up.railway.app"

# Password for expert / clinician mode (choose a strong value; never commit real passwords)
EXPERT_PASSWORD = "change-me-in-production"

# Supabase Postgres (optional — see database/README.md)
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY = "your-secret-key"
